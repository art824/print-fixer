---
import { defectArt } from '../data/defect-art';

interface Props {
  slug: string;
  size?: number;
}

const { slug, size = 64 } = Astro.props;
const art = defectArt[slug];
---

{art && (
  <svg
    class="defect-art"
    viewBox="0 0 72 56"
    width={size}
    height={Math.round((size * 56) / 72)}
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={art}
  />
)}
